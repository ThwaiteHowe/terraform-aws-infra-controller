{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": "*",
      "Action": [
        "s3:ListBucket",
        "s3:GetObject",
        "s3:PutBucketPolicy"
      ],
      "Resource": [
        "arn:aws:s3:::dev.thwaitehowe.com",
        "arn:aws:s3:::dev.thwaitehowe.com/*"
      ]
    },
    {
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::430118840082:user/terraform"
      },
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:PutBucketPolicy"
      ],
      "Resource": [
        "arn:aws:s3:::dev.thwaitehowe.com",
        "arn:aws:s3:::dev.thwaitehowe.com/*"
      ]
    }
  ]
  }